---
layout: base.njk
permalink: "/"
eleventyComputed:
  title: "{{ archive.title }}"
  description: "{{ archive.description }}"
---
<div class="wrap">

  <div class="titleblock">
    <h1>{{ archive.title }}</h1>
    <dl>
      {%- for fact in archive.facts %}
      <div>
        <dt>{{ fact.label }}</dt>
        <dd>{{ fact.value }}</dd>
      </div>
      {%- endfor %}
    </dl>
  </div>

  <div class="lede">
    <p>{{ archive.description }}</p>
    <p>The log records what was built, when, by whom, and what went wrong.
      Each sheet here is a scan of the original alongside a transcription that
      follows the marks on the page as closely as the medium allows.</p>
  </div>

  <section class="search">
    <h2>Search the log</h2>
    <label for="q" class="sr-only">Search the transcribed log</label>
    <input type="search" id="q" autocomplete="off" spellcheck="false"
           placeholder="Search {{ pages | length }} pages of transcribed entries"
           aria-describedby="search-note">
    <p class="search-note" id="search-note">Matches text as it appears on the page, marks and all.</p>
    <ul class="results" id="results" aria-live="polite"></ul>
  </section>

  {%- set readyBrowse = browse | selectattr("ready") | list %}
  {%- if readyBrowse | length %}
  <section>
    <h2>Browse</h2>
    <ul class="browse">
      {%- for entry in readyBrowse %}
      <li>
        <a href="{{ entry.href | url }}">
          <b>{{ entry.label }}</b>
          <span>{{ entry.blurb }}</span>
        </a>
      </li>
      {%- endfor %}
    </ul>
  </section>
  {%- endif %}

  <section>
    <h2>Every page</h2>
    <ul class="pages">
      {%- for record in pages %}
      <li>
        <a href="{{ ('/page/' + record.number + '/') | url }}">
          <img src="{{ ('/thumbs/' + record.scanId + '.jpg') | url }}"
               alt="Sheet {{ record.number }}" width="180" height="240" loading="lazy" decoding="async">
          <span>{{ record.number }}</span>
        </a>
      </li>
      {%- endfor %}
    </ul>
  </section>

</div>
<script src="{{ '/assets/search.js' | url }}" data-index="{{ '/search-index.json' | url }}" defer></script>
