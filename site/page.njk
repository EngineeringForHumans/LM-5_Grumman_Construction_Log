---
pagination:
  data: pages
  size: 1
  alias: page_record
permalink: "/page/{{ page_record.number }}/"
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Page {{ page_record.number }}</title>
<link rel="stylesheet" href="{{ '/assets/transcript.css' | url }}">
</head>
<body>
<h1>Page {{ page_record.number }}</h1>
<p>Status: {{ page_record.status }}</p>

<img src="{{ ('/scans/' + page_record.scanId + '.jpg') | url }}" alt="Scan of page {{ page_record.number }}">

<div class="transcript-view">
  <input type="checkbox" id="line-breaks" class="line-breaks-toggle">
  <label class="line-breaks-label" for="line-breaks">Show original line breaks</label>
  <div class="transcript">{{ page_record.text | transcript | safe }}</div>
</div>

<p><a href="{{ ('/page/' + page_record.number + '/transcript.txt') | url }}">Plain text transcript</a></p>
</body>
</html>
